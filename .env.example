# Copy of the variables ./entrypoint.sh generates in .env. Never use these values.
POSTGRES_PASSWORD=change-me
BANK_MIGRATOR_PASSWORD=change-me
BANK_APP_PASSWORD=change-me
BANK_AUDITOR_PASSWORD=change-me
# Authenticates the lab on the chaos ports (lock 4 of docs/chaos-bot.md).
CENTAVO_CHAOS_TOKEN=change-me
# Signs the partner's webhooks (docs/architecture.md, section 4.2).
PARTNER_WEBHOOK_SECRET=change-me

# Optional overrides.
# CENTAVO_DEFENSES=robust
# CENTAVO_VERSION=dev
